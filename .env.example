# Yellow ClearNode WebSocket (Nitrolite RPC)
WS_URL=wss://clearnet.yellow.com/ws

# Server wallet key used to authenticate with ClearNode and sign app sessions. Never commit a real one.
SERVER_PRIVATE_KEY=

# Nitrolite / Polygon configuration
CHAIN_ID=137
USDC_TOKEN_ADDRESS=
CUSTODY_ADDRESS=
ADJUDICATOR_ADDRESS=
DEFAULT_GUEST_ADDRESS=
POLYGON_RPC_URL=https://polygon-rpc.com

# WebSocket server port
PORT=8080
